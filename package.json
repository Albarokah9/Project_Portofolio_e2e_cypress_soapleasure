{
    "name": "e2e_soapleasure",
    "version": "1.0.0",
    "description": "E2E Testing for Soapleasure with Cypress",
    "author": "Albarokah Rifansah Sutanto Putra",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Albarokah9/Project_Portofolio_e2e_cypress_soapleasure.git"
    },
    "scripts": {
        "// ========== Cypress Test Execution ==========": "",
        "cy:open": "cypress open",
        "cy:run": "cypress run --env allure=true",
        "cy:run:headed": "cypress run --headed --env allure=true",
        "// ========== Browser-specific Tests ==========": "",
        "cy:open:chrome": "cypress open --browser chrome",
        "cy:open:firefox": "cypress open --browser firefox",
        "cy:open:edge": "cypress open --browser edge",
        "cy:run:chrome": "cypress run --browser chrome --env allure=true",
        "cy:run:firefox": "cypress run --browser firefox --env allure=true",
        "cy:run:edge": "cypress run --browser edge --env allure=true",
        "// ========== Test by Folder/Spec ==========": "",
        "test:auth": "cypress run --spec \"cypress/e2e/Authentication/**/*.cy.js\" --env allure=true",
        "test:shop": "cypress run --spec \"cypress/e2e/Shop/**/*.cy.js\" --env allure=true",
        "test:login": "cypress run --spec \"cypress/e2e/Authentication/Login.cy.js\" --env allure=true",
        "test:register": "cypress run --spec \"cypress/e2e/Authentication/Register.cy.js\" --env allure=true",
        "test:forgot": "cypress run --spec \"cypress/e2e/Authentication/ForgotPassword.cy.js\" --env allure=true",
        "test:logout": "cypress run --spec \"cypress/e2e/Authentication/Logout.cy.js\" --env allure=true",
        "test:checkout": "cypress run --spec \"cypress/e2e/Shop/Checkout.cy.js\" --env allure=true",
        "// ========== Tagged Tests ==========": "",
        "test:smoke": "cypress run --env grepTags=@smoke,allure=true",
        "test:regression": "cypress run --env grepTags=@regression,allure=true",
        "// ========== Allure Reports ==========": "",
        "allure:generate": "allure generate ./allure-results -o ./allure-report --clean",
        "allure:open": "allure open ./allure-report",
        "allure:serve": "allure serve ./allure-results",
        "allure:clean": "rimraf ./allure-results ./allure-report",
        "// ========== Complete Test Workflows ==========": "",
        "test": "npm run clean:reports && npm run cy:run && npm run allure:generate",
        "test:report": "npm run test && npm run allure:open",
        "test:serve": "npm run clean:reports && npm run cy:run && npm run allure:serve",
        "// ========== Cleanup ==========": "",
        "clean": "rimraf ./allure-results ./allure-report ./cypress/screenshots ./cypress/videos ./test-output.log",
        "clean:reports": "rimraf ./allure-results ./allure-report",
        "clean:screenshots": "rimraf ./cypress/screenshots",
        "clean:videos": "rimraf ./cypress/videos",
        "// ========== Code Quality ==========": "",
        "lint": "eslint cypress/**/*.js",
        "lint:fix": "eslint cypress/**/*.js --fix",
        "format": "prettier --write \"cypress/**/*.{js,json}\"",
        "format:check": "prettier --check \"cypress/**/*.{js,json}\"",
        "// ========== CI/CD ==========": "",
        "ci": "npm run clean:reports && npm run cy:run",
        "ci:chrome": "npm run clean:reports && npm run cy:run:chrome",
        "ci:parallel": "cypress run --record --parallel --env allure=true",
        "// ========== Utilities ==========": "",
        "pretest": "npm run clean:reports",
        "postinstall": "cypress verify"
    },
    "cypress": {
        "video": false,
        "screenshotOnRunFailure": true,
        "viewportWidth": 1280,
        "viewportHeight": 720,
        "defaultCommandTimeout": 10000,
        "pageLoadTimeout": 60000,
        "env": {
            "grepTags": "@smoke"
        }
    },
    "devDependencies": {
        "@shelex/cypress-allure-plugin": "2.41.2",
        "@testing-library/cypress": "^10.0.3",
        "allure-commandline": "^2.34.1",
        "cypress": "^15.7.1",
        "esbuild": "^0.25.4",
        "mkdirp": "^3.0.1",
        "prettier": "^3.5.3",
        "rimraf": "^6.0.1",
        "xlsx": "^0.18.5"
    }
}
